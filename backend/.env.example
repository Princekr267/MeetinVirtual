# Server Port
PORT=3000

# MongoDB Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/meetinvirtual

# Client URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Optional: Public Backend URL (used in Google OAuth callback if deployed)
# BACKEND_URL=http://localhost:3000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Configuration for OTP Password Reset (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

